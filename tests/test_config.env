# 隔离测试环境配置
# 用于单元测试、集成测试和基准测试的独立环境

# 数据目录（包含数据库、上传、导出）
LAW_REVIEW_DATA_DIR=./output/test_data

# LLM 服务配置
LAW_REVIEW_LLM_URL=http://127.0.0.1:8000/v1
LAW_REVIEW_LLM_MODEL=Qwythos-9B-v2-4bit-mlx
LAW_REVIEW_LLM_TEMPERATURE=0.0
LAW_REVIEW_LLM_MAX_TOKENS=900
LAW_REVIEW_LLM_TIMEOUT=180

# Redis 配置（批量导入队列）
REDIS_URL=redis://localhost:6379
ARQ_QUEUE_NAME=law_review_test_tasks
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT=3600

# 覆盖率配置
COVERAGE_FILE=./output/coverage/.coverage

# 测试模式标志
TEST_MODE=true
