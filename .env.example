# Copy to .env, review values, then explicitly load it in your shell:
# set -a; . ./.env; set +a
# The application does not silently load a dotenv file. Never commit .env.

# Private data (relative to the process working directory, or use an absolute path).
LAW_REVIEW_DATA_DIR=./data
# Empty selects the checkpoint file beside the business database.
LAW_REVIEW_LANGGRAPH_CHECKPOINT_DB=

# local accepts only loopback peers; any proxy/LAN/public deployment MUST use token.
LAW_REVIEW_AUTH_MODE=local
LAW_REVIEW_JSON_LOGS=0
LAW_REVIEW_LOG_LEVEL=INFO
LAW_REVIEW_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# token mode requires a non-empty JSON mapping. Each key is a random >=32-character
# secret; values contain a unique name, boolean admin and positive integer case_ids.
# Generate actual secrets outside this template; never commit or paste them into logs.
LAW_REVIEW_API_TOKENS_JSON='{}'

# Application LLM: one configured local model, not automatic multi-model routing.
LAW_REVIEW_LLM_URL=http://127.0.0.1:8000/v1
LAW_REVIEW_LLM_MODEL=Qwythos-9B-v2-4bit-mlx
LAW_REVIEW_LLM_TEMPERATURE=0.2
LAW_REVIEW_LLM_MAX_TOKENS=900
LAW_REVIEW_LLM_TIMEOUT=180
LAW_REVIEW_AGENT_CRITIC_MODEL=Qwythos-9B-v2-4bit-mlx
LAW_REVIEW_AGENT_CRITIC_TIMEOUT=180

# Embedding cache identity. Change REVISION whenever same-named weights change.
LAW_REVIEW_EMBEDDING_URL=http://127.0.0.1:8000/v1
LAW_REVIEW_EMBEDDING_MODEL=Qwen3-Embedding-4B-4bit-DWQ
LAW_REVIEW_EMBEDDING_REVISION=local-v1
# LangGraph has tracing clients as transitive dependencies; cloud tracing stays off.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Redis is needed only for batch imports; bind its server to loopback.
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE_NAME=law_review_tasks
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT=3600

# Upload limits are bytes / file counts (not MiB strings).
LAW_REVIEW_MAX_UPLOAD_SIZE=209715200
LAW_REVIEW_MAX_UPLOAD_TOTAL_SIZE=536870912
LAW_REVIEW_MAX_FILES_PER_UPLOAD=30
LAW_REVIEW_BATCH_UPLOAD_LIMIT=200
LAW_REVIEW_INDEXING_CONCURRENCY=2
