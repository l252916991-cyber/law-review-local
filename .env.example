# Copy to .env, review values, then explicitly load it in your shell:
# set -a; . ./.env; set +a
# The application does not silently load a dotenv file. Never commit .env.

# Container deployment: web binds to loopback by default; put TLS proxy in front.
WEB_PORT=8000
LAW_REVIEW_ALLOWED_HOSTS=localhost,127.0.0.1

# Empty selects the checkpoint file beside the business database.
LAW_REVIEW_LANGGRAPH_CHECKPOINT_DB=

# local accepts only loopback peers; any proxy/LAN/public deployment MUST use token.
LAW_REVIEW_AUTH_MODE=local
# Docker Desktop forwards loopback-published ports through the Compose bridge gateway.
# Set this to the source address observed by the Web container (commonly 172.18.0.1).
# Keep empty outside Docker; never add LAN client addresses in local auth mode.
LAW_REVIEW_TRUSTED_LOCAL_PEERS=
LAW_REVIEW_JSON_LOGS=0
LAW_REVIEW_LOG_LEVEL=INFO
LAW_REVIEW_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# token mode requires a non-empty JSON mapping. Each key is a random >=32-character
# secret; values contain a unique name, boolean admin and positive integer case_ids.
# Optional "permissions" lists one or more of view, edit, approve, export, manage.
# Omitting permissions keeps the legacy behaviour (everything except manage for
# non-admins); new configurations should list them explicitly. Generate actual
# secrets outside this template; never commit or paste them into logs.
# Short tokens are refused unless LAW_REVIEW_ALLOW_INSECURE_LOCAL_TOKEN=1 AND
# LAW_REVIEW_ALLOWED_HOSTS is loopback-only; never enable that for a shared host.
LAW_REVIEW_API_TOKENS_JSON='{}'

# Application LLM: one configured local model, not automatic multi-model routing.
# Endpoints outside the loopback addresses are refused unless you explicitly set
# LAW_REVIEW_ALLOW_REMOTE_MODELS=1 AND use https for them. Redirects are refused.
LAW_REVIEW_LLM_URL=http://127.0.0.1:8000/v1
# Compose maps loopback addresses entered in the browser to the host model service.
# Leave empty when the application itself runs directly on the host.
LAW_REVIEW_MODEL_LOOPBACK_HOST=
LAW_REVIEW_LLM_MODEL=Qwythos-9B-v2-4bit-mlx
LAW_REVIEW_LLM_TEMPERATURE=0.2
LAW_REVIEW_LLM_MAX_TOKENS=900
LAW_REVIEW_LLM_TIMEOUT=180
LAW_REVIEW_AGENT_CRITIC_MODEL=Qwythos-9B-v2-4bit-mlx
LAW_REVIEW_AGENT_CRITIC_TIMEOUT=180
# Keep unset for local-only deployments. Setting it to 1 approves remote model
# egress for the whole application (chat and embeddings); case text will leave
# this machine to the approved https endpoints.
LAW_REVIEW_ALLOW_REMOTE_MODELS=

# Embedding cache identity. Change REVISION whenever same-named weights change.
LAW_REVIEW_EMBEDDING_URL=http://127.0.0.1:8000/v1
LAW_REVIEW_EMBEDDING_MODEL=Qwen3-Embedding-4B-4bit-DWQ
LAW_REVIEW_EMBEDDING_REVISION=local-v1
LAW_REVIEW_RERANK_URL=http://127.0.0.1:8000/v1
LAW_REVIEW_RERANK_MODEL=bge-reranker-v2-m3-mlx
# Quality mode: model errors fail the request; no semantic or answer fallback.
LAW_REVIEW_ALLOW_DEGRADED_MODE=
# LangGraph has tracing clients as transitive dependencies; cloud tracing stays off.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Redis is needed only for batch imports; bind its server to loopback.
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE_NAME=law_review_tasks
ARQ_MAX_JOBS=10
ARQ_JOB_TIMEOUT=3600

# Optional organizational login (OIDC authorization code). Leave all three
# empty to keep it disabled; partial configuration fails closed. The issuer
# must be https outside loopback. LAW_REVIEW_OIDC_PRINCIPALS_JSON maps verified
# subjects to principals: {"<sub>": {"name": "...", "case_ids": [...],
# "permissions": ["view", "edit"]}}; identities missing from the mapping are
# refused. Real issuer connectivity is a deployment acceptance item.
LAW_REVIEW_OIDC_ISSUER=
LAW_REVIEW_OIDC_CLIENT_ID=
LAW_REVIEW_OIDC_CLIENT_SECRET=
LAW_REVIEW_OIDC_PRINCIPALS_JSON='{}'
LAW_REVIEW_OIDC_SCOPES=openid profile

# Upload limits are bytes / file counts (not MiB strings).
LAW_REVIEW_MAX_UPLOAD_SIZE=209715200
LAW_REVIEW_MAX_UPLOAD_TOTAL_SIZE=536870912
LAW_REVIEW_MAX_FILES_PER_UPLOAD=30
LAW_REVIEW_BATCH_UPLOAD_LIMIT=200
LAW_REVIEW_INDEXING_CONCURRENCY=2

# Read-only statutory corpus: a directory holding manifest.json plus one JSON
# document per statute (schema lexvault-public-laws-v1). Point this at the
# canonical corpus, e.g. /data/legal_corpus. When unset or when schema/hash
# validation fails, statutory verification returns needs_review and GET
# /api/ready reports legal_verification=unavailable; the case workspace still
# runs. Law text is an immutable deployment artifact, never case data.
LAW_REVIEW_LEGAL_CORPUS_DIR=
